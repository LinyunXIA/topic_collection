feishu_webhook: "https://open.feishu.cn/open-apis/bot/v2/hook/<dev-token>"
feishu_secret: "<dev-secret>"
bootstrap_days: 1
site:
  top_n: 5
http:
  timeout_seconds: 20
  user_agent: "rss2feishu/0.2 (local dev; private)"
feeds:
  - name: "量子位"
    url: "https://www.qbitai.com/feed"
bitable:
  enabled: true
  app_token: "<dev-app-token>"
  table_id: "<dev-table-id>"
  url: "https://web91vfvm7.feishu.cn/base/<dev-app-token>"
  retention_days: 365
salon:
  enabled: true
  app_token: "<salon-app-token>"
  table_id: "<salon-table-id>"
  wiki_space_id: "<wiki-space-id>"
  wiki_parent_token: "<wiki-parent-token>"
  trigger_weekday: 4
  trigger_hour: 10
  trigger_minute: 0
minimax:
  api_key: "<minimax-key via MiniMax_Key env>"
  model: "MiniMax-M3"
  base_url: "https://api.minimaxi.com"
wiki:
  space_id: "<wiki-space-id>"
  parent_token: "<wiki-parent-token>"
  app_token: "<wiki-app-token>"
extract:
  enabled: true
  since_days: 7
  batch_size: 30
  provider: minimax
  prompt_file: prompts/extract.md
  max_calls: 0
  providers:
    minimax:
      api_key: "<minimax-key via MiniMax_Key env>"
      model: "MiniMax-M3"
      base_url: "https://api.minimaxi.com/v1"
      tool_label: "MMax"
    deepseek:
      api_key: "<deepseek-key via DEEPSEEK_API_KEY env>"
      model: "deepseek-flash"
      base_url: "https://api.deepseek.com/v1"
      tool_label: "DS"

score:
  enabled: true
  prompt_file: prompts/score.md
  batch_size: 20
  timeout_seconds: 600
  provider: minimax
  max_calls: 0
  providers:
    minimax:
      api_key: "<minimax-key via MiniMax_Key env>"
    deepseek:
      api_key: "<deepseek-key via DEEPSEEK_API_KEY env>"
